{
  "name": "topnotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:eslint-config": "node --test tests/eslint-config.test.mjs",
    "test:styles": "node --test tests/styles-architecture.test.mjs",
    "test:window-drag": "node --test tests/window-drag.test.mjs",
    "test:note-window": "node --test tests/note-window.test.mjs",
    "test:markdown": "node --test tests/markdown.test.mjs",
    "test:tags": "node --test tests/tags.test.mjs tests/library.test.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "lint": "npm run eslint && npm run stylelint && npm run prettier",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix && npm run prettier:fix",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint '**/*.{css,scss,vue}' --ignore-path .prettierignore",
    "stylelint:fix": "stylelint '**/*.{css,scss,vue}' --ignore-path .prettierignore --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@eslint/css": "^1.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.0.7",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "3.8.1",
    "sass": "^1.103.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.5"
  }
}
